{
  "name": "deck-sage-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postbuild": "node preview/tools/build-local-scanner.cjs && node preview/tools/build-accounts.cjs && node preview/tools/assemble.cjs",
    "preview:homepage": "node preview/tools/serve.cjs --port 4184",
    "test:homepage": "node tests/regression/homepage-redesign.cjs",
    "test:cards": "node tests/regression/card-library-search.cjs && node tests/regression/card-catalog-refresh.cjs && node tests/regression/card-library-ui.cjs",
    "test:publisher": "node tests/regression/publisher-policy.cjs && node tests/regression/publisher-ui.cjs",
    "test:publisher:hosted": "node tests/regression/publisher-hosted.cjs",
    "test:decks": "node tests/regression/commander-display-art.cjs && node tests/regression/my-decks.cjs && node tests/regression/deck-details-war-table.cjs",
    "test:upgrades": "node tests/regression/commander-upgrades.cjs",
    "test:coach": "node tests/regression/gameplay-coach-policy.cjs && node tests/regression/gameplay-coach-ui.cjs",
    "test:value": "node tests/regression/card-value-pricing.cjs && node tests/regression/card-value.cjs",
    "test:batch-upload": "node tests/regression/batch-upload.cjs",
    "test:bulk-discovery": "node tests/regression/bulk-deck-discovery.cjs && node tests/regression/bulk-deck-discovery-ui.cjs",
    "test:news": "node tests/regression/daily-news.cjs && node tests/regression/daily-news-ui.cjs",
    "test:ai-scan": "node tests/regression/ai-scan-gateway.cjs && node tests/regression/image-memory-guard.cjs && node tests/regression/local-scan-worker-lifecycle.cjs && node tests/regression/local-scan-matcher.cjs && node tests/regression/ai-scan.cjs",
    "test:songs": "node tests/regression/commander-theme-player.cjs && node tests/regression/songs.cjs",
    "test:accounts": "node tests/accounts/shared-sql.cjs && node tests/accounts/shared-controller.cjs && node tests/accounts/bulk-atomic-persistence.cjs && node tests/accounts/legacy-hardening.cjs",
    "test:accounts:browser": "node tests/accounts/shared-controller.cjs",
    "test:accounts:hosted": "node tests/accounts/shared-hosted.cjs",
    "test:accounts:hosted-ui": "node tests/accounts/shared-ui-hosted.cjs",
    "test:bulk-discovery:hosted-ui": "node tests/accounts/bulk-discovery-hosted-ui.cjs",
    "test:accounts:hardening": "node tests/accounts/legacy-hardening.cjs",
    "build:local-scanner": "node preview/tools/build-local-scanner.cjs",
    "test:local-scan-safety": "node tests/regression/image-memory-guard.cjs && node tests/regression/local-scan-worker-lifecycle.cjs",
    "test:avatars": "node tests/regression/profile-avatars.cjs",
    "test:avatars:ui": "node tests/regression/profile-avatars-ui.cjs",
    "test:precons": "node tests/regression/precon-catalog-refresh.cjs && node tests/regression/precon-library.cjs && node tests/regression/precon-library-ui.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.2",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@huggingface/transformers": "3.8.1",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "brotli-dec-wasm": "2.3.2",
    "esbuild": "0.28.2",
    "onnxruntime-web": "1.30.0",
    "supabase": "2.120.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
